#!/usr/bin/env node
/**
 * mnblog — thin agent-friendly CLI for the mnblog Jekyll theme.
 * Zero npm dependencies.
 * Commands: init | new | check | publish | serve | editor | ask | desk
 */
"use strict";

const fs = require("fs");
const path = require("path");
const { spawnSync, spawn } = require("child_process");

const VERSION = "0.2.0";
const ROOT = path.resolve(__dirname, "..");

function usage(code = 0) {
  const text = `mnblog ${VERSION} — Jekyll theme + agent CLI

Usage:
  mnblog init [dir]                  Create a site from example/ (vendors theme)
  mnblog new "title" [options]       Create _posts/YYYY-MM-DD-slug.md
  mnblog check [path]                Validate post front matter / filename
  mnblog publish [--message|-m] [--dry-run]
  mnblog serve                       Run or print jekyll serve
  mnblog editor                      Serve editor/ locally
  mnblog ask [--agent claude|codex|auto] [prompt...] [-- agent-args...]
  mnblog desk [--agent claude|codex|auto] [-- agent-args...]
  mnblog help | --help | -h
  mnblog version | --version | -v

new options:
  --tags a,b,c     Comma-separated tags
  --draft          Write under _drafts/ instead of _posts/
  --subtitle text  Optional subtitle
  --summary text   Optional summary
  --author name    Default from _config.yml title or "author"
  --date ISO       Override date (default: now, Asia/Shanghai wall clock if TZ set)

ask / desk:
  Resolve the nearest site root (_config.yml + _posts/).
  Ensure AGENTS.md and skills/mnblog/ are present (copy from package if missing).
  Launch the local Claude Code (\`claude\`) or Codex (\`codex\`) CLI — no cloud keys in mnblog.
  --agent auto     Prefer claude when both exist (default)
  desk             Interactive TTY session in the site root
  ask              One-shot: claude -p … / codex exec … ; without a prompt, falls back to desk

Agent tips:
  Prefer editing Markdown files directly, then mnblog check && mnblog publish.
  Do not invent images. Do not use a browser for GitHub — use gh / git.
`;
  process.stdout.write(text);
  process.exit(code);
}

function die(msg, code = 1) {
  process.stderr.write(`mnblog: ${msg}\n`);
  process.exit(code);
}

function parseFlags(argv) {
  const flags = { _: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--dry-run") flags.dryRun = true;
    else if (a === "--draft") flags.draft = true;
    else if (a === "--tags" || a === "-t") flags.tags = argv[++i];
    else if (a === "--subtitle") flags.subtitle = argv[++i];
    else if (a === "--summary") flags.summary = argv[++i];
    else if (a === "--author") flags.author = argv[++i];
    else if (a === "--date") flags.date = argv[++i];
    else if (a === "--message" || a === "-m") flags.message = argv[++i];
    else if (a.startsWith("-")) die(`unknown flag: ${a}`);
    else flags._.push(a);
  }
  return flags;
}

/** Parse ask/desk args: --agent, positional prompt, and pass-through after -- */
function parseAgentArgs(argv) {
  const flags = { agent: "auto", _: [], passthrough: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--") {
      flags.passthrough = argv.slice(i + 1);
      break;
    }
    if (a === "--agent") {
      const v = argv[++i];
      if (!v || v.startsWith("-")) die("usage: --agent claude|codex|auto");
      flags.agent = v;
      continue;
    }
    if (a.startsWith("--agent=")) {
      flags.agent = a.slice("--agent=".length);
      continue;
    }
    if (a === "--help" || a === "-h") usage(0);
    if (a.startsWith("-")) die(`unknown flag: ${a} (pass agent flags after --)`);
    flags._.push(a);
  }
  const allowed = new Set(["auto", "claude", "codex"]);
  if (!allowed.has(flags.agent)) {
    die(`invalid --agent ${flags.agent} (use claude|codex|auto)`);
  }
  return flags;
}

function shanghaiNow() {
  const fmt = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false,
  });
  const parts = Object.fromEntries(
    fmt.formatToParts(new Date()).map((p) => [p.type, p.value])
  );
  let hour = parts.hour === "24" ? "00" : parts.hour;
  return {
    dateFile: `${parts.year}-${parts.month}-${parts.day}`,
    dateFront: `${parts.year}-${parts.month}-${parts.day} ${hour}:${parts.minute}:${parts.second} +0800`,
  };
}

function slugify(title) {
  return (
    String(title)
      .trim()
      .toLowerCase()
      .replace(/['"]/g, "")
      .replace(/[^a-z0-9\u4e00-\u9fff]+/gi, "-")
      .replace(/^-+|-+$/g, "")
      .replace(/-{2,}/g, "-")
      .slice(0, 80) || "post"
  );
}

/** Soft finder for content commands: _config.yml OR _posts */
function findSiteRoot(start = process.cwd()) {
  let dir = path.resolve(start);
  for (;;) {
    if (
      fs.existsSync(path.join(dir, "_config.yml")) ||
      fs.existsSync(path.join(dir, "_posts"))
    ) {
      return dir;
    }
    const parent = path.dirname(dir);
    if (parent === dir) return process.cwd();
    dir = parent;
  }
}

/** Strict finder for ask/desk: need both _config.yml and _posts/ */
function findBlogSiteRoot(start = process.cwd()) {
  let dir = path.resolve(start);
  for (;;) {
    const hasConfig = fs.existsSync(path.join(dir, "_config.yml"));
    const hasPosts = fs.existsSync(path.join(dir, "_posts"));
    if (hasConfig && hasPosts) return dir;
    const parent = path.dirname(dir);
    if (parent === dir) {
      die(
        "no blog site found (need _config.yml + _posts/). cd into a site from `mnblog init`, or pass nothing and run from that directory."
      );
    }
    dir = parent;
  }
}

function readConfigTitle(siteRoot) {
  const cfg = path.join(siteRoot, "_config.yml");
  if (!fs.existsSync(cfg)) return null;
  const text = fs.readFileSync(cfg, "utf8");
  const m = text.match(/^title:\s*["']?([^"'#\n]+)/m);
  return m ? m[1].trim() : null;
}

function copyDir(src, dest) {
  fs.mkdirSync(dest, { recursive: true });
  for (const entry of fs.readdirSync(src, { withFileTypes: true })) {
    if (entry.name === ".git" || entry.name === "node_modules") continue;
    const from = path.join(src, entry.name);
    const to = path.join(dest, entry.name);
    if (entry.isDirectory()) copyDir(from, to);
    else fs.copyFileSync(from, to);
  }
}

function commandExists(name) {
  // Prefer POSIX command -v; avoid shell injection (name is a fixed token).
  if (!/^[a-zA-Z0-9_-]+$/.test(name)) return null;
  const r = spawnSync("sh", ["-c", `command -v ${name}`], {
    encoding: "utf8",
  });
  if (r.status === 0 && r.stdout.trim()) return r.stdout.trim();
  return null;
}

/**
 * Detect local agent CLIs. Returns { name, bin } or dies with a clear message.
 * auto → prefer claude when both exist.
 */
function resolveAgent(preference) {
  const claude = commandExists("claude");
  const codex = commandExists("codex");
  const want = preference || "auto";

  if (want === "claude") {
    if (!claude) {
      die(
        "claude not found on PATH. Install Claude Code (https://code.claude.com) and ensure `claude` works in this shell."
      );
    }
    return { name: "claude", bin: claude };
  }
  if (want === "codex") {
    if (!codex) {
      die(
        "codex not found on PATH. Install OpenAI Codex CLI and ensure `codex` works in this shell."
      );
    }
    return { name: "codex", bin: codex };
  }
  // auto
  if (claude) return { name: "claude", bin: claude };
  if (codex) return { name: "codex", bin: codex };
  die(
    "neither `claude` nor `codex` found on PATH.\n" +
      "  Install Claude Code (https://code.claude.com) and/or the OpenAI Codex CLI,\n" +
      "  then re-run: mnblog desk   or   mnblog ask \"…\"\n" +
      "  mnblog does not store API keys — use whatever login those CLIs already use."
  );
}

/**
 * Ensure AGENTS.md + skills/mnblog/ exist in the site (copy from package if missing).
 * Returns { agentsPath, skillPath, copied: string[] }
 */
function ensureAgentsAndSkill(site) {
  const copied = [];
  const agentsSrc = path.join(ROOT, "AGENTS.md");
  const agentsDest = path.join(site, "AGENTS.md");
  if (!fs.existsSync(agentsDest)) {
    if (!fs.existsSync(agentsSrc)) die(`package missing AGENTS.md at ${agentsSrc}`);
    fs.copyFileSync(agentsSrc, agentsDest);
    copied.push("AGENTS.md");
  }

  const skillSrcDir = path.join(ROOT, "skills", "mnblog");
  const skillDestDir = path.join(site, "skills", "mnblog");
  const skillDest = path.join(skillDestDir, "SKILL.md");
  if (!fs.existsSync(skillDest)) {
    if (!fs.existsSync(path.join(skillSrcDir, "SKILL.md"))) {
      die(`package missing skills/mnblog/SKILL.md`);
    }
    copyDir(skillSrcDir, skillDestDir);
    copied.push("skills/mnblog/");
  }

  return {
    agentsPath: agentsDest,
    skillPath: skillDest,
    packageSkillPath: path.join(skillSrcDir, "SKILL.md"),
    copied,
  };
}

function printAgentContext(site, ctx, agent) {
  process.stdout.write(`mnblog desk/ask → site ${site}\n`);
  process.stdout.write(`  agent: ${agent.name} (${agent.bin})\n`);
  process.stdout.write(`  AGENTS.md: ${ctx.agentsPath}\n`);
  process.stdout.write(`  skill:     ${ctx.skillPath}\n`);
  if (ctx.copied.length) {
    process.stdout.write(`  copied:    ${ctx.copied.join(", ")}\n`);
  }
}

function runInherit(cmd, args, opts = {}) {
  return spawnSync(cmd, args, { stdio: "inherit", ...opts });
}

function run(cmd, args, opts = {}) {
  return spawnSync(cmd, args, { stdio: "inherit", ...opts });
}

function spawnAgentInteractive(agent, args, cwd) {
  // Interactive: need a real TTY when available; inherit always.
  const child = spawn(agent.bin, args, {
    cwd,
    stdio: "inherit",
    env: process.env,
  });
  child.on("error", (err) => {
    die(`failed to launch ${agent.name}: ${err.message}`);
  });
  child.on("exit", (code, signal) => {
    if (signal) {
      process.kill(process.pid, signal);
      return;
    }
    process.exit(code == null ? 1 : code);
  });
}

function cmdInit(argv) {
  const flags = parseFlags(argv);
  const target = path.resolve(flags._[0] || "my-blog");
  if (fs.existsSync(target) && fs.readdirSync(target).length > 0) {
    die(`target not empty: ${target}`);
  }
  fs.mkdirSync(target, { recursive: true });

  copyDir(path.join(ROOT, "example"), target);

  for (const dir of ["_layouts", "_includes", "_sass", "assets", "css", "js"]) {
    const src = path.join(ROOT, dir);
    if (fs.existsSync(src)) copyDir(src, path.join(target, dir));
  }

  const agentsSrc = path.join(ROOT, "AGENTS.md");
  if (fs.existsSync(agentsSrc)) {
    fs.copyFileSync(agentsSrc, path.join(target, "AGENTS.md"));
  }
  const skillSrc = path.join(ROOT, "skills", "mnblog");
  if (fs.existsSync(path.join(skillSrc, "SKILL.md"))) {
    copyDir(skillSrc, path.join(target, "skills", "mnblog"));
  }

  // Convenience: symlink or copy CLI into site bin/
  const siteBin = path.join(target, "bin");
  fs.mkdirSync(siteBin, { recursive: true });
  fs.copyFileSync(path.join(ROOT, "bin", "mnblog"), path.join(siteBin, "mnblog"));
  try {
    fs.chmodSync(path.join(siteBin, "mnblog"), 0o755);
  } catch (_) {
    /* ignore */
  }

  process.stdout.write(
    `Created site at ${target}\n` +
      `Next:\n` +
      `  cd ${target}\n` +
      `  # edit _config.yml (title, url, nav)\n` +
      `  bundle install   # needs Ruby + Bundler\n` +
      `  bundle exec jekyll serve\n` +
      `  # or: ./bin/mnblog new "My post" && ./bin/mnblog publish\n` +
      `  # agent session: ./bin/mnblog desk\n`
  );
}

function cmdNew(argv) {
  const flags = parseFlags(argv);
  const title = flags._.join(" ").trim();
  if (!title) die('usage: mnblog new "title" [--tags a,b] [--draft]');

  const site = findSiteRoot();
  let frontDate;
  let fileDate;
  if (flags.date) {
    const m = String(flags.date).match(/^(\d{4}-\d{2}-\d{2})/);
    if (!m) die(`bad --date: ${flags.date}`);
    fileDate = m[1];
    frontDate = String(flags.date).includes("+")
      ? String(flags.date)
      : `${m[1]} 12:00:00 +0800`;
  } else {
    const now = shanghaiNow();
    fileDate = now.dateFile;
    frontDate = now.dateFront;
  }

  const slug = slugify(title);
  const dirName = flags.draft ? "_drafts" : "_posts";
  const dir = path.join(site, dirName);
  fs.mkdirSync(dir, { recursive: true });

  const filename = flags.draft ? `${slug}.md` : `${fileDate}-${slug}.md`;
  const filepath = path.join(dir, filename);
  if (fs.existsSync(filepath)) die(`already exists: ${filepath}`);

  const author = flags.author || readConfigTitle(site) || "author";
  const tags = (flags.tags || "")
    .split(",")
    .map((t) => t.trim())
    .filter(Boolean);

  const lines = [
    "---",
    "layout: post",
    `title: ${JSON.stringify(title)}`,
  ];
  if (flags.subtitle) lines.push(`subtitle: ${JSON.stringify(flags.subtitle)}`);
  lines.push(`date: ${frontDate}`);
  lines.push(`author: ${JSON.stringify(author)}`);
  if (tags.length) {
    lines.push("tags:");
    for (const t of tags) lines.push(`    - ${t}`);
  }
  if (flags.summary) lines.push(`summary: ${JSON.stringify(flags.summary)}`);
  lines.push("---", "", `<!-- write the post -->`, "");

  fs.writeFileSync(filepath, lines.join("\n"), "utf8");
  process.stdout.write(`${filepath}\n`);
}

function parseFrontMatter(text) {
  if (!text.startsWith("---")) return null;
  const end = text.indexOf("\n---", 3);
  if (end < 0) return null;
  return text.slice(3, end).trim();
}

function cmdCheck(argv) {
  const flags = parseFlags(argv);
  const site = findSiteRoot();
  let targets = flags._.map((p) => path.resolve(p));
  if (targets.length === 0) {
    const posts = path.join(site, "_posts");
    if (!fs.existsSync(posts)) die(`no _posts in ${site}`);
    targets = fs
      .readdirSync(posts)
      .filter((f) => f.endsWith(".md"))
      .map((f) => path.join(posts, f));
  }

  let errors = 0;
  for (const file of targets) {
    if (!fs.existsSync(file)) {
      process.stderr.write(`MISSING ${file}\n`);
      errors++;
      continue;
    }
    const base = path.basename(file);
    const text = fs.readFileSync(file, "utf8");
    const fm = parseFrontMatter(text);
    const problems = [];

    if (!fm) problems.push("missing YAML front matter");
    else {
      if (!/^layout:\s*post\b/m.test(fm) && !/^layout:\s*["']?post/m.test(fm)) {
        problems.push("layout should be post");
      }
      if (!/^title:\s*.+/m.test(fm)) problems.push("missing title");
      if (!/^date:\s*.+/m.test(fm)) problems.push("missing date");
    }

    if (file.includes(`${path.sep}_posts${path.sep}`)) {
      if (!/^\d{4}-\d{2}-\d{2}-.+\.md$/.test(base)) {
        problems.push("filename should be YYYY-MM-DD-slug.md");
      }
    }

    if (problems.length) {
      errors++;
      process.stderr.write(`FAIL ${file}\n  - ${problems.join("\n  - ")}\n`);
    } else {
      process.stdout.write(`OK   ${file}\n`);
    }
  }
  if (errors) process.exit(1);
}

function cmdPublish(argv) {
  const flags = parseFlags(argv);
  const site = findSiteRoot();
  const message =
    flags.message || `content: update ${shanghaiNow().dateFile}`;

  if (!fs.existsSync(path.join(site, ".git"))) {
    die(`not a git repo: ${site} (git init + remote first)`);
  }

  const status = spawnSync("git", ["status", "--porcelain"], {
    cwd: site,
    encoding: "utf8",
  });
  if (status.status !== 0) die("git status failed");
  if (!status.stdout.trim()) {
    process.stdout.write("nothing to publish\n");
    return;
  }

  process.stdout.write(status.stdout);
  if (flags.dryRun) {
    process.stdout.write(`[dry-run] would commit: ${message}\n`);
    process.stdout.write(`[dry-run] would git push\n`);
    return;
  }

  let r = run("git", ["add", "-A"], { cwd: site });
  if (r.status !== 0) die("git add failed");
  r = run("git", ["commit", "-m", message], { cwd: site });
  if (r.status !== 0) die("git commit failed (maybe empty?)");
  r = run("git", ["push"], { cwd: site });
  if (r.status !== 0) die("git push failed — use gh auth / check remote");
  process.stdout.write("published\n");
}

function cmdServe() {
  const site = findSiteRoot();
  const hasBundle =
    fs.existsSync(path.join(site, "Gemfile")) &&
    spawnSync("bundle", ["--version"], { encoding: "utf8" }).status === 0;

  if (hasBundle) {
    process.stdout.write(`Serving with bundle exec jekyll serve in ${site}\n`);
    const r = run("bundle", ["exec", "jekyll", "serve"], { cwd: site });
    process.exit(r.status || 0);
  }

  process.stdout.write(
    `Ruby/Bundler not ready in ${site}.\n` +
      `Install deps, then run:\n` +
      `  bundle install\n` +
      `  bundle exec jekyll serve\n` +
      `Or open the built site on GitHub Pages after publish.\n`
  );
}

function cmdEditor() {
  const editorDir = path.join(ROOT, "editor");
  if (!fs.existsSync(path.join(editorDir, "index.html"))) {
    die(`editor missing at ${editorDir}`);
  }
  const port = process.env.MNBLOG_EDITOR_PORT || "4173";
  process.stdout.write(
    `mnblog editor (v0.1 stub)\n` +
      `Serving ${editorDir} at http://127.0.0.1:${port}/\n` +
      `Publish still runs via CLI: mnblog publish\n` +
      `Ctrl+C to stop.\n`
  );
  const r = run("python3", ["-m", "http.server", port, "--bind", "127.0.0.1"], {
    cwd: editorDir,
  });
  process.exit(r.status || 0);
}

function prepareAgentSession(argv) {
  const flags = parseAgentArgs(argv);
  const site = findBlogSiteRoot();
  const ctx = ensureAgentsAndSkill(site);
  const agent = resolveAgent(flags.agent);
  printAgentContext(site, ctx, agent);
  return { flags, site, ctx, agent };
}

function cmdDesk(argv) {
  const { flags, site, agent } = prepareAgentSession(argv);
  const args = flags.passthrough.slice();
  // Optional: if positional tokens exist on desk, treat as initial prompt hint for claude
  const hint = flags._.join(" ").trim();
  if (hint) {
    if (agent.name === "claude") {
      // Interactive Claude accepts an initial prompt as a positional arg
      args.unshift(hint);
    } else {
      process.stdout.write(
        `note: desk with Codex ignores positional prompt; paste it in the TUI, or use:\n` +
          `  mnblog ask --agent codex ${JSON.stringify(hint)}\n`
      );
    }
  }
  process.stdout.write(`launching interactive ${agent.name} in ${site} …\n`);
  spawnAgentInteractive(agent, args, site);
}

function cmdAsk(argv) {
  const { flags, site, agent } = prepareAgentSession(argv);
  const prompt = flags._.join(" ").trim();
  const extra = flags.passthrough.slice();

  if (!prompt) {
    process.stdout.write(
      "mnblog ask: no prompt given — falling back to interactive desk.\n" +
        "Hint: mnblog ask \"draft a post about X\"\n"
    );
    process.stdout.write(`launching interactive ${agent.name} in ${site} …\n`);
    spawnAgentInteractive(agent, extra, site);
    return;
  }

  let args;
  if (agent.name === "claude") {
    // Non-interactive: claude -p "prompt" [extra…]
    args = ["-p", prompt, ...extra];
  } else {
    // Codex one-shot: codex exec "prompt" [extra…]
    // Note: older docs mentioned different flags; exec is the stable non-interactive entry.
    args = ["exec", prompt, ...extra];
  }

  process.stdout.write(
    `ask (${agent.name} one-shot) in ${site}\n` +
      `  $ ${agent.name} ${args.map((a) => (/\s/.test(a) ? JSON.stringify(a) : a)).join(" ")}\n`
  );
  const r = runInherit(agent.bin, args, { cwd: site });
  process.exit(r.status == null ? 1 : r.status);
}

function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];
  if (!cmd || cmd === "help" || cmd === "--help" || cmd === "-h") usage(0);
  if (cmd === "version" || cmd === "--version" || cmd === "-v") {
    process.stdout.write(`${VERSION}\n`);
    return;
  }
  const rest = argv.slice(1);
  switch (cmd) {
    case "init":
      return cmdInit(rest);
    case "new":
      return cmdNew(rest);
    case "check":
      return cmdCheck(rest);
    case "publish":
      return cmdPublish(rest);
    case "serve":
      return cmdServe();
    case "editor":
      return cmdEditor();
    case "ask":
      return cmdAsk(rest);
    case "desk":
      return cmdDesk(rest);
    default:
      die(`unknown command: ${cmd}\nRun mnblog help`);
  }
}

main();
